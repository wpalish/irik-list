  "narrative": {
    "northStar": "Collection Labels for Working Decisions",
    "overview": "Museum collection-label precision is the implemented working metaphor: forest navigation, pale mint ground, white current records and warm paper for the published brief, draft and frozen history. This is a code-derived description of an author-inferred world. The owner confirmed the priority of criteria and reasons; the visual world was not approved by the owner.\n\nLocal Noto carries both RU and KK. Native controls, named condition rows and compact version captions support careful comparison without turning fictional codes into portraits or promotional imagery. The built signature is a peach version caption that becomes a text-labelled conflict; the provisional surface brief’s vertical mark did not become a card stripe.",
    "keyCharacteristics": [
      "Flat, bordered working surfaces with forest actions.",
      "Three named reasons remain text, rather than a color-only verdict.",
      "Peach marks the selected version; a changed version includes text and an explicit action.",
      "Compact narrow layouts keep localized navigation words intact."
    ],
    "rules": [
      {
        "name": "The Caption Rule",
        "body": "Use peach on the version caption of a selected record. A changed version carries its old-to-current text and conflict boundary; color alone does not describe the change.",
        "section": "colors"
      },
      {
        "name": "The One Local Voice Rule",
        "body": "Use the bundled Noto family across navigation, data, forms and headings. Keep version numerals tabular and labels in their natural RU/KK case.",
        "section": "typography"
      },
      {
        "name": "The Flat Record Rule",
        "body": "Separate records with fills, spacing and thin borders. The current system uses no box shadows.",
        "section": "elevation"
      }
    ],
    "dos": [
      "**Do** preserve the text label and value for each city, language and topic reason.",
      "**Do** retain native-sized controls, associated field errors and the visible rust focus outline.",
      "**Do** let whole navigation controls move to another row on narrow screens.",
      "**Do** distinguish selected, changed, frozen and archived states with text as well as their existing treatments."
    ],
    "donts": [
      "**Don't** split localized navigation labels into arbitrary letter fragments.",
      "**Don't** replace a changed-version explanation with a colored stripe alone.",
      "**Don't** add elevation shadows to these flat record surfaces as an assumed house style.",
      "**Don't** present the inferred visual world as owner-approved."
    ]
  }
}
